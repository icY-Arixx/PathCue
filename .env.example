# Offline mode works without any keys.
EMBEDDING_BACKEND=model2vec
EMBEDDING_MODEL=minishlab/potion-multilingual-128M
MODEL_CACHE_DIR=data/models
VECTOR_BACKEND=local
EMBEDDING_DIMENSIONS=384
CHUNK_SIZE=520
CHUNK_OVERLAP=80
DENSE_WEIGHT=0.55
SPARSE_WEIGHT=0.45
RETRIEVE_K=8
FINAL_K=4
MIN_EVIDENCE_SCORE=0.30

# Zhipu free text model; only server reads this credential. No automatic paid fallback.
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4.7-flash

# Optional Amap Web Service key.
AMAP_API_KEY=
# Browser-only JS API credentials. Never put the Web Service key here.
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=
# Bump on weight/version changes, including custom model replacements at same path.
EMBEDDING_REVISION=v1
EMBEDDING_API_MODEL=text-embedding-v3

# Optional Milvus deployment.
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=urban_mobility_chunks

# Optional bounded online evidence. TinyFish Search discovers pages and TinyFish
# Fetch reads source text before PathCue cites it. Keep the key server-side.
ONLINE_SEARCH_BACKEND=tinyfish
TINYFISH_API_KEY=
TINYFISH_SEARCH_URL=https://api.search.tinyfish.ai
TINYFISH_FETCH_URL=https://api.fetch.tinyfish.ai
WEB_SEARCH_TIMEOUT_S=10
WEB_SEARCH_MAX_RESULTS=5
PAGE_READ_TIMEOUT_S=8
PAGE_READ_MAX_BYTES=1000000
EVIDENCE_CACHE_TTL_S=86400

# Optional Cloudflare fallback. Set ONLINE_SEARCH_BACKEND=cloudflare to use it.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_GATEWAY_ID=default
WEB_SEARCH_PROVIDER=ceramic
WEB_SEARCH_BYOK_ALIAS=

# Public mode binds every trip and location receipt to a signed visitor cookie.
# Use a random 32+ character secret and HTTPS in deployment. Keep false for local HTTP.
PUBLIC_ACCESS_MODE=false
PUBLIC_SESSION_SECRET=
PUBLIC_COOKIE_SECURE=true
PUBLIC_REQUESTS_PER_MINUTE=20
