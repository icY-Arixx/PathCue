# Offline mode works without any keys.
EMBEDDING_BACKEND=model2vec
EMBEDDING_MODEL=minishlab/potion-multilingual-128M
MODEL_CACHE_DIR=data/models
VECTOR_BACKEND=local
EMBEDDING_DIMENSIONS=384
CHUNK_SIZE=520
CHUNK_OVERLAP=80
DENSE_WEIGHT=0.55
SPARSE_WEIGHT=0.45
RETRIEVE_K=8
FINAL_K=4
MIN_EVIDENCE_SCORE=0.30

# Optional OpenAI-compatible embedding/chat endpoint.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen-plus

# Optional Amap Web Service key.
AMAP_API_KEY=

# Optional Milvus deployment.
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=urban_mobility_chunks
